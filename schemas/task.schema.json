{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": ["task_id", "project_id", "title", "description", "acceptance_criteria", "risk_level"],
  "properties": {
    "task_id": {"type": "string"},
    "project_id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "writable_paths": {"type": "array", "items": {"type": "string"}},
    "read_only_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_commands": {"type": "array", "items": {"type": "string"}},
    "required_secrets": {"type": "array", "items": {"type": "string"}}
  }
}
